# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/workforce_manager

# Dedicated, disposable database for integration/e2e tests (see README > Test).
# Never point this at the same database as DATABASE_URL — tests TRUNCATE it.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/workforce_manager_test

# Secret used to sign JWT auth cookies — required in production
JWT_SECRET=generate-a-long-random-secret

# Key used to encrypt administrator MFA secrets — required in production
MFA_ENCRYPTION_KEY=generate-another-long-random-secret

# Initial admin account created by `npm run db:seed` (only if no users exist yet).
# SEED_ADMIN_PASSWORD is required and must never be committed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_NAME=Admin

# Port for the Express server
PORT=3000
