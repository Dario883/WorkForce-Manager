# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/workforce_manager

# Secret used to sign JWT auth cookies — change this in production
JWT_SECRET=change-me-to-a-long-random-string

# Default admin account created by `pnpm db:seed` (only if no users exist yet)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=Admin

# Port for the Express server
PORT=3000
