# Core
NODE_ENV=production
PORT=3000

# Database (required)
DATABASE_URL=mysql://user:password@localhost:3306/workforce_manager

# Session JWT secret (required)
JWT_SECRET=change-me-to-a-long-random-secret

# Auth mode: local|oauth
# local = no external OAuth dependency
APP_AUTH_MODE=local
VITE_AUTH_MODE=local

# Optional owner mapping (used by DB upsert role logic)
OWNER_OPEN_ID=

# OAuth mode only (required only when APP_AUTH_MODE=oauth)
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=

# Optional Forge integrations (leave empty to disable related features)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
